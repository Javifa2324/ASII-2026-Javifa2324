@startuml

left to right direction
skinparam packageStyle rectangle

actor "Usuario hospitalario\nautorizado" as Usuario

rectangle "Dashboard de ocupación hospitalaria" {

    usecase "Consultar ocupación\nhospitalaria" as UC1
    usecase "Validar acceso\ny permisos" as UC2
    usecase "Consolidar información\nde camas" as UC3
    usecase "Visualizar ocupación\npor sala" as UC4
    usecase "Filtrar por sala" as UC5
    usecase "Filtrar por estado\nde cama" as UC6
    usecase "Consultar detalle\nde camas" as UC7
}

Usuario -- UC1
Usuario -- UC5
Usuario -- UC6
Usuario -- UC7

UC1 .> UC2 : <<include>>
UC1 .> UC3 : <<include>>
UC1 .> UC4 : <<include>>

UC5 .> UC1 : <<extend>>
UC6 .> UC1 : <<extend>>
UC7 .> UC4 : <<extend>>

@enduml
